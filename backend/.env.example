PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h
DB_PATH=./data/proctorshield.db
FRONTEND_URL=https://clearview-room.lovable.app

# Supabase Integration (Get these from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OTP Email (use Mailtrap for dev, real SMTP for prod)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
OTP_FROM=noreply@proctorshield.app
OTP_EXPIRES_MINUTES=10
